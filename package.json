{
  "name": "cybermp-typescript-template",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack TypeScript monorepo template for CyberMP gamemodes. Includes Client, Server and CEF UI with live HMR support.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "download": "node scripts/download-cybermp.mjs",
    "download:win": "node scripts/download-cybermp.mjs win",
    "download:linux": "node scripts/download-cybermp.mjs linux",
    "win": "pnpm run dev:win",
    "linux": "pnpm run dev:linux",
    "dev": "node scripts/start-server.mjs dev",
    "dev:win": "cross-env NODE_ENV=development mp\\win\\cybermp-server.exe -run -rdir=./resources",
    "dev:linux": "cross-env NODE_ENV=development ./mp/linux/cybermp-server -run -rdir=$(pwd)/resources",
    "dev:docker": "docker compose -f docker-compose.dev.yml up",
    "docker": "docker compose up -d --build",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "prod": "node scripts/start-server.mjs prod",
    "prod:win": "cross-env NODE_ENV=production mp\\win\\cybermp-server.exe -run -rdir=./resources",
    "prod:linux": "cross-env NODE_ENV=production ./mp/linux/cybermp-server -run -rdir=$(pwd)/resources",
    "start": "pnpm run prod",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "watch:no-browser": "node scripts/build.mjs --watch --no-browser",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "adm-zip": "^0.6.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7"
  },
  "cybermp": {
    "version": "v4.0.4-beta.1"
  },
  "packageManager": "pnpm@12.21.0"
}
